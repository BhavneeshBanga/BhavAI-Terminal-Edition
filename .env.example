# BhavAI Environment Variables

# The API Subscription Key obtained from the Sarvam AI Dashboard.
# Get your key at https://dashboard.sarvam.ai/
SARVAM_API_KEY=sk_5h0hwdqd_t6YAUU2Zl33wHXCDtTQKMtBV

# ─────────────────────────────────────────────────────────
# Google Calendar Agent
# ─────────────────────────────────────────────────────────
# 1. Go to: https://console.cloud.google.com
# 2. New Project → APIs & Services → Enable "Google Calendar API"
# 3. Credentials → Create → OAuth 2.0 Client ID → Desktop App
# 4. Download JSON → rename to credentials.json → place in project root
# 5. Run BhavAI → say "schedule event..." → browser will open for first-time login
# 6. token.json will be auto-created (don't share it)

GOOGLE_CREDENTIALS_PATH=credentials.json
USER_TIMEZONE=Asia/Kolkata
USER_NAME=User
